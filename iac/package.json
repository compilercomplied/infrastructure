{
    "name": "infrastructure",
    "main": "index.ts",
    "scripts": {
        "validate:oidc": "node scripts/validate-oidc.cjs",
        "check:app-access": "node scripts/check-app-access.cjs",
        "check:security": "node scripts/check-workload-security.cjs",
        "check:keycloak": "node scripts/check-keycloak.cjs",
        "check:host-provision": "node scripts/check-host-provision.cjs",
        "check": "tsc --noEmit && npm run validate:oidc && npm run check:app-access && npm run check:security && npm run check:keycloak && npm run check:host-provision && npm run check:api-tokens",
        "check:api-tokens": "node scripts/check-api-tokens.cjs"
    },
    "devDependencies": {
        "@types/node": "^18",
        "js-yaml": "^4.3.2",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@pulumi/forgejo": "file:sdks/forgejo",
        "@pulumi/keycloak": "6.14.2",
        "@pulumi/kubernetes": "^4.0.0",
        "@pulumi/pulumi": "^3.113.0",
        "@pulumi/random": "4.19.1",
        "@pulumi/tailscale": "0.29.4"
    }
}
