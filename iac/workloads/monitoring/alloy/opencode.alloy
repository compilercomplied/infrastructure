otelcol.receiver.otlp "opencode" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.filter.opencode.input]
  }
}

otelcol.processor.filter "opencode" {
  error_mode = "propagate"
  traces {
    // Alloy 1.7 can inspect the link count but cannot transform individual link attributes.
    span = [`Len(links) > 0`]
  }
  output {
    traces = [otelcol.processor.transform.opencode.input]
  }
}

otelcol.processor.transform "opencode" {
  // AI SDK spans can contain repository evidence and tool payloads.
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name", "service.version", "opencode.client"])`,
    ]
  }
  trace_statements {
    context = "scope"
    statements = [
      `keep_keys(attributes, [])`,
      `set(name, "opencode")`,
      `set(version, "")`,
    ]
  }
  trace_statements {
    context = "span"
    statements = [
      `keep_keys(attributes, ["session.id", "ai.model.id", "ai.model.provider", "ai.usage.inputTokens", "ai.usage.outputTokens", "ai.usage.promptTokens", "ai.usage.completionTokens"])`,
      `set(status.message, "")`,
      `set(trace_state, "")`,
      `set(name, "opencode.operation") where not IsMatch(name, "^ai[.](streamText|generateText)([.](doStream|doGenerate))?$")`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [
      `keep_keys(attributes, [])`,
      `set(name, "event")`,
    ]
  }
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}
